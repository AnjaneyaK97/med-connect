# ==============================================================================
# MediConnect Environment Configuration Template
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000
GATEWAY_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# PostgreSQL Configuration
POSTGRES_USER=mediconnect
POSTGRES_PASSWORD=mediconnect_secret_change_in_prod
POSTGRES_DB=mediconnect_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://mediconnect:mediconnect_secret_change_in_prod@postgres:5432/mediconnect_db?schema=public

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets (Minimum 32 characters in production)
JWT_ACCESS_SECRET=mediconnect_jwt_access_super_secret_key_32bytes_min!
JWT_REFRESH_SECRET=mediconnect_jwt_refresh_super_secret_key_32bytes_min!
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Field-Level Encryption Master Key (AES-256-GCM 32-byte hex/base64 key)
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# AI Service Configuration
AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_PORT=8000

# Vector Database (ChromaDB)
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# Ollama LLM Configuration
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3

# Whisper STT Configuration
WHISPER_MODEL=base
WHISPER_DEVICE=cpu

# Log Level
LOG_LEVEL=info
